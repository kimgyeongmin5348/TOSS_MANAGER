# Either set one full SQLAlchemy URL:
# TIDB_DATABASE_URL=mysql+pymysql://user:password@host:4000/database?ssl_verify_cert=true&ssl_verify_identity=true

# Or use separate TiDB connection values:
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=your_database
DB_SSL=true

# Optional when credentials are entered in the Streamlit login screen.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_API_BASE_URL=https://openapi.tossinvest.com

# Optional news providers. Porto Manager still works without these values.
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
OPENDART_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWS_REFRESH_SECONDS=60
